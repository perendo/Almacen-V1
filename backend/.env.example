# Configuración de ejemplo. Copiar a .env y ajustar los valores.
# NO usar estos valores en producción.

DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/wms_db

# Obligatoria: mínimo 32 caracteres aleatorios.
# El arranque falla si contiene marcadores de ejemplo o es demasiado corta.
SECRET_KEY=cambiar-por-clave-de-al-menos-32-caracteres-segura

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Solo true si hay un proxy propio que sobrescribe X-Forwarded-For.
# Si se expone la API directamente, dejarlo en false para evitar spoofing.
TRUST_PROXY_HEADERS=false

PROJECT_NAME=WMS - Gestión de Almacén e Inventario
API_V1_STR=/api/v1
ENVIRONMENT=development

# Rate limiting (login cuenta solo intentos fallidos)
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REFRESH_RATE_LIMIT=30
REFRESH_RATE_WINDOW_SECONDS=60

# Retención del audit trail (RGPD art. 5.1.e): 5 años
AUDIT_RETENTION_DAYS=1825

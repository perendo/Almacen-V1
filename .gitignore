# ============================================
# .gitignore — WMS Gestión de Almacén e Inventario
# ============================================

# --- Entorno virtual Python ---
.venv/
venv/
env/
ENV/
.venv*/

# --- Archivos de entorno (contienen secretos) ---
.env
.env.local
.env.*.local

# --- Base de datos SQLite ---
*.db
*.sqlite
*.sqlite3
wms.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt
.hypothesis/
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# --- Node.js / Frontend ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tgz
.next/
out/
dist/
build/

# --- IDEs y editores ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Cobertura y reportes temporales ---
coverage.xml
report.html

# --- Otros ---
*.bak
*.tmp
*.temp

# --- Sesiones de OpenCode (no commitear) ---
.opencode/